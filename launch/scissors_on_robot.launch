<launch>
  <!--
    Launch scissors attached to HIRONX right arm.
    - Starts dynamixel_scissors (motor control + angle converter + RSP)
    - Publishes static TF: RARM_JOINT5_Link → scissor/base_link
    - Scissors visualization appears in RViz on the robot arm
  -->

  <arg name="port_name" default="/dev/ttyUSB0" />
  <arg name="baud_rate" default="57600" />
  <arg name="protocol_1_0" default="false" />
  <arg name="launch_rviz" default="false" />
  <arg name="enable_connection_monitor" default="true" />

  <!-- Mount offset from scissors.yaml:
       translation: [-0.0635, -0.01, 0.200]
       rotation_rpy: [0, 0, pi/2] → quat: [0, 0, 0.707107, 0.707107] -->

  <!-- Static TF: RARM_JOINT5_Link → scissor/base_link -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="scissors_mount_tf"
        args="-0.0635 -0.01 0.200 0 0 0.707107 0.707107 RARM_JOINT5_Link scissor/base_link" />

  <!-- Dynamixel hardware control (respawn enabled for reconnection) -->
  <include file="$(find dynamixel_general_hw)/launch/dynamixel_general_control.launch">
    <arg name="port_name" value="$(arg port_name)" />
    <arg name="baud_rate" value="$(arg baud_rate)" />
    <arg name="namespace" value="ros_scissor" />
    <arg name="robot_description_file" value="$(find dynamixel_scissors)/urdf/scissor.urdf" />
    <arg name="dynamixel_info_file" value="$(find dynamixel_scissors)/config/dynamixel_info.yaml" unless="$(arg protocol_1_0)" />
    <arg name="dynamixel_info_file" value="$(find dynamixel_scissors)/config/dynamixel_info_1_0.yaml" if="$(arg protocol_1_0)" />
    <arg name="controllers_file" value="$(find dynamixel_scissors)/config/scissor_controllers.yaml" />
    <arg name="controllers_to_start" value="joint_state_controller position_joint_trajectory_controller" />
    <arg name="launch_robot_state_publisher" value="false" />
    <arg name="launch_rviz" value="false" />
    <arg name="required" value="false" />
    <arg name="respawn" value="true" />
  </include>

  <!-- Angle converter: motor angle → blade angle -->
  <node pkg="dynamixel_scissors" type="scissors_angle_converter.py" name="scissors_angle_converter" output="screen">
    <param name="motor_x" value="0.01"/>
    <param name="motor_z" value="-0.070"/>
    <param name="crank_length" value="0.022"/>
    <param name="coupler_length" value="0.067"/>
    <param name="rocker_length" value="0.067"/>
    <param name="assembly_mode" value="0"/>
    <param name="closed_motor_angle" value="0.50"/>
  </node>

  <!-- RSP: publishes scissor/* child frames from joint_states_converted -->
  <node ns="ros_scissor" name="robot_state_publisher"
        pkg="robot_state_publisher" type="robot_state_publisher">
    <remap from="joint_states" to="joint_states_converted"/>
  </node>

  <!-- Scissor control node -->
  <node pkg="dynamixel_scissors" type="scissor_control_node.py" name="scissor_control" output="screen"/>

  <!-- Connection monitor: detects garbage data from failed syncRead, restarts dynamixel node -->
  <node if="$(arg enable_connection_monitor)"
        pkg="dynamixel_scissors" type="scissors_connection_monitor.py"
        name="scissors_connection_monitor" output="screen">
  </node>
</launch>
